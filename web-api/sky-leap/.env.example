# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Load it with: uv run --env-file .env <command>

# Pinecone API key (secret). Required.
PINECONE_API_KEY=

# Pinecone index name. Default: portfolio-rag
PINECONE_INDEX=portfolio-rag

# Namespace inside the index. Default: v1
PINECONE_NAMESPACE=v1

# AWS Region for Bedrock. Keep in us-east-1 (same Region as Pinecone Starter). Default: us-east-1
AWS_REGION=ap-south-1

# Bedrock embedding model. Default: amazon.titan-embed-text-v2:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Embedding size; must match the Pinecone index dimension. Titan V2 supports 256, 512 or 1024. Default: 1024
EMBED_DIMENSIONS=1024

# AWS profile for boto session
AWS_PROFILE=test

CHUNK_NAME=Your chunk name

# Top k chunks will be retrieved
CHUNK_NUM=5